OPENAI_API_KEY=
OPENAI_MODEL=
NYLAS_API_KEY=
NYLAS_CLIENT_ID=
NYLAS_GRANT_ID=
WEBHOOK_SECRET=
SERVER_URL=
DATABASE_URL=
APP_API_KEY=
PROCESSING_MODE=
TEST_EMAIL=
# CONFIDENCE_THRESHOLD is optional (defaults to 0.7) — omit it entirely
# rather than setting it to an empty value, which would fail to parse
# as a float. Uncomment and set a value only if you want to override it:
# CONFIDENCE_THRESHOLD=0.7
# STORE_RAW_EVENT_FILES is optional (defaults to true) — same rule as
# above (empty string won't parse as a bool either):
# STORE_RAW_EVENT_FILES=true
# DRY_RUN is optional (defaults to false) — same rule as above. Set to
# true to approve actions without calling Nylas (see README, "Offline
# development"):
# DRY_RUN=false
# EMBEDDING_MODEL is optional (defaults to text-embedding-3-small) and
# must produce 1536-dimensional vectors:
# EMBEDDING_MODEL=text-embedding-3-small
# RAG_MIN_SCORE is optional: the minimum cosine similarity for an email
# to be returned by /search or used by /ask. Defaults to 0.30, from the
# `uv run python -m eval.run_retrieval` sweep: it keeps 20/20 answerable
# questions, 0.053 below the lowest answerable top-1 score (0.353). It is
# a cost guard (no model call when nothing is close); the model's
# `answerable` flag provides precision (`uv run python -m eval.run_ask`):
# RAG_MIN_SCORE=0.30
# ENVIRONMENT is optional: `local` (default) or `production`. Production
# disables /docs, /redoc and /openapi.json:
# ENVIRONMENT=local
# PROCESS_EVENTS_INLINE is optional (defaults to false). Set to true on
# hosts that throttle CPU after the response is sent (e.g. Cloud Run):
# POST /events then triages inside the request with an 8 second budget,
# leaving timed-out events for `python -m scripts.reprocess_raw_events`:
# PROCESS_EVENTS_INLINE=false
# DB_POOL_SIZE and DB_MAX_OVERFLOW are optional (default 5 and 0): each
# process (every Cloud Run instance, every reprocess job run) opens at
# most DB_POOL_SIZE + DB_MAX_OVERFLOW database connections. Supabase's
# session pooler allows 15 client connections in total, so keep
# (max instances + jobs) x (DB_POOL_SIZE + DB_MAX_OVERFLOW) well below 15:
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=0
# LANGFUSE_PUBLIC_KEY and LANGFUSE_SECRET_KEY are optional: tracing is
# active only when both are set (and LANGFUSE_TRACING_ENABLED is not
# false). Without them the app runs untraced. LANGFUSE_BASE_URL defaults
# to Langfuse Cloud (EU); set it for the US region or a self-hosted
# instance (README, "Observability"):
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_TRACING_ENABLED is optional (defaults to true). `false` turns
# tracing off even when keys are set:
# LANGFUSE_TRACING_ENABLED=true
# TRACE_EMAIL_CONTENT is optional (defaults to false). Email text and
# addresses reach Langfuse only when this is true AND PROCESSING_MODE=test;
# otherwise traces carry redacted text:
# TRACE_EMAIL_CONTENT=false
