# CONFIDENCE_THRESHOLD is optional (defaults to 0.7) — omit it entirely
# rather than setting it to an empty value, which would fail to parse
# as a float. Uncomment and set a value only if you want to override it:
# CONFIDENCE_THRESHOLD=0.7
# STORE_RAW_EVENT_FILES is optional (defaults to true) — same rule as
# above (empty string won't parse as a bool either):
# STORE_RAW_EVENT_FILES=true
